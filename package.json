{
  "name": "dsh-agents",
  "version": "0.1.0",
  "description": "DSH 侧的 23 个专职角色 × 模型档位路由：把 oh-my-claudecode 的角色体系移植成 DSH 工具（agent_roles / agent_taskbook / agent_spawn），按角色钉死模型档位（LOW/MEDIUM/HIGH ← haiku/sonnet/opus）并一步派活。",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node tests/run.mjs && node tests/isolation-gate.mjs && node tests/advisor-llm-replay.mjs && node tests/skill-sync-check.mjs && node tests/boot-schema-check.mjs && node tools/crgate.test.mjs && node tools/publish-scan.test.mjs && node tools/verify-imp26.mjs && node tools/taskbook-26a-negative.mjs && node tools/opt-b2-s3-gate.mjs --selftest && node tools/alias-contract-gate.mjs && node tools/constraint-audit.mjs && node tools/verifiability-check.mjs && node tools/project-status-gate.mjs --execute",
    "test:unit": "node tests/run.mjs",
    "gate:isolation": "node tests/isolation-gate.mjs",
    "gate:isolation:selftest": "node tests/isolation-gate.mjs --selftest",
    "gate:replay": "node tests/advisor-llm-replay.mjs",
    "gate:counts": "node tests/skill-sync-check.mjs",
    "gate:boot": "node tests/boot-schema-check.mjs",
    "gate:crgate": "node tools/crgate.test.mjs",
    "gate:publish-scan": "node tools/publish-scan.test.mjs",
    "gate:persona": "node tools/verify-imp26.mjs",
    "gate:taskbook26a": "node tools/taskbook-26a-negative.mjs",
    "gate:injection": "node tools/opt-b2-s3-gate.mjs --selftest",
    "gate:alias": "node tools/alias-contract-gate.mjs",
    "gate:constraints": "node tools/constraint-audit.mjs",
    "gate:verifiability": "node tools/verifiability-check.mjs",
    "gate:project-status": "node tools/project-status-gate.mjs --execute",
    "gate:project-status:selftest": "node tools/project-status-gate.mjs --selftest",
    "gate:constraint-mutation": "node tools/constraint-mutation-verify.mjs",
    "gate:constraint-mutation:selftest": "node tools/constraint-mutation-verify.mjs --selftest"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "web-tree-sitter": "0.27.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
